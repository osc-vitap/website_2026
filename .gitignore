.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node
node_modules/
dist/
dist-ssr/

# Poster masters pulled from R2 and the PDF built from them — half a
# gigabyte of print artwork that lives in the bucket, not here.
/dist-posters/

# Entry passes. devices.json holds scanner tokens in the clear and the
# QR images are working credentials: anyone holding one can walk in.
/.test-passes/
/entry-qr/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated poster QR codes — regenerate with scripts/make-poster-qr.mjs
/qr/*.png

# Archives of the generated QR codes, for handing to the design tool
*.zip
