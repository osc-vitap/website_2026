/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",

	"name": "osc-events-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-20",

	"observability": {
		"enabled": true
	},

	"upload_source_maps": true,

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "osc-events-db",
			"database_id": "dd7fdbce-852d-41b3-a2cf-6106cdb69fc6"
		}
	],

	/**
	 * Comma-separated list of browser origins allowed to call this
	 * Worker. http://localhost:5173 and http://127.0.0.1:5173 are
	 * always allowed in addition to these.
	 */
	"vars": {
		"ALLOWED_ORIGINS": "https://www.oscvitap.com,https://oscvitap.com",

		/**
		 * Comma-separated GitHub handles allowed into the admin
		 * dashboard, on top of the osc-vitap organisation membership
		 * check. Leave empty to allow anyone in the organisation.
		 */
		"ADMIN_GITHUB_USERS": "",

		/**
		 * Comma-separated hex digests of the NUMERIC GitHub user ids
		 * allowed into the dashboard WITHOUT being in the osc-vitap
		 * organisation.
		 *
		 * A deliberate hole in the only real gate this admin has: such an
		 * account is trusted on GitHub's word alone, with no organisation
		 * to revoke it. Keep it to people who genuinely cannot be added
		 * to the org, and empty it once they can. Every use is logged.
		 *
		 * Ids, not handles. This keyed on the handle until an adversarial
		 * review pointed out that GitHub logins are mutable and are not
		 * reserved when released: rename or delete an exempt account and
		 * whoever claims the username next inherits the exemption, which
		 * is full admin over registrant PII and the session eviction
		 * endpoint. Numeric ids are never reassigned. The name changed
		 * from ADMIN_OUTSIDER_HASHES at the same time so a stale
		 * handle digest cannot be mistaken for a live one.
		 *
		 * Digests, not plaintext, because this repository is public and
		 * the old plaintext var named a real person on every clone. Each
		 * entry is HMAC-SHA256 of the id under the ADMIN_HANDLE_PEPPER
		 * secret — without that secret the digest says nothing about who
		 * is listed, and it cannot be reversed by counting up through the
		 * id space the way a bare SHA-256 can.
		 *
		 * Add one with (the id comes from https://api.github.com/users/<handle>):
		 *   node -e "const c=require('crypto');console.log(c.createHmac('sha256',process.env.P).update(process.argv[1].trim()).digest('hex'))" <id>
		 * with P set to the same pepper the Worker holds.
		 */
		"ADMIN_OUTSIDER_ID_HASHES": "11e443787d6cfb8c0a4cb5ab8d6cfd6c6243296de58337f7fc4817304ca41492"
	},

	/**
	 * Secrets this Worker needs, set with `wrangler secret put <NAME>`.
	 *
	 * An audit flagged this block as a field Wrangler does not recognise
	 * and silently ignores. That is wrong, and it was checked: removing
	 * it removes the "Missing required secrets: GITHUB_CLIENT_ID,
	 * GITHUB_CLIENT_SECRET" warning that Wrangler prints when either is
	 * absent. It stays.
	 */
	"secrets": {
		"required": [
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",

			/*
			 * The Discord webhook that announces registrations. It is a
			 * credential — anyone holding the URL can post to the
			 * channel — so it is never committed. With it unset the
			 * announcement is skipped and registration is unaffected.
			 */
			"DISCORD_WEBHOOK_URL",

			/*
			 * The key ADMIN_OUTSIDER_ID_HASHES is computed under. It is
			 * what makes those committed digests meaningless to anyone
			 * reading this repository, so it is never committed itself.
			 * With it unset nobody is exempt from the organisation check —
			 * the hole closes rather than opens.
			 *
			 * Rotated when the exemption moved from handles to ids, and
			 * again when two reviews reached opposite conclusions about
			 * whether the deployed pepper still matched the digest above.
			 * Secrets are write-only, so neither could be checked and no
			 * amount of reading settles it. Regenerating the pepper and
			 * the digest together is what makes them agree; if they ever
			 * look doubtful again, redo that rather than reason about it.
			 * Always set it from a file — an argument lands in the shell
			 * history:
			 *   npx wrangler secret put ADMIN_HANDLE_PEPPER < pepper.txt
			 * then recompute every digest above under the new value, or
			 * the people listed there are locked out.
			 */
			"ADMIN_HANDLE_PEPPER",

			/*
			 * The Gmail account and app password the seat confirmation
			 * mail is sent from, with either unset sending is skipped.
			 */
			"OSC_SMTP_USER",
			"OSC_SMTP_PASS"
		]
	},

	/**
	 * Rate limiting (Workers rate limiting API, open beta — hence
	 * "unsafe"). Counters are per-Cloudflare-location and periods are
	 * limited to 10 or 60 seconds.
	 *
	 * The university NATs the whole campus through a handful of IPs, so
	 * a plain per-IP limit would lock every student out the moment a
	 * class registers together. Instead:
	 *
	 *  - REGISTRATION_ID_LIMITER keys on the registration number being
	 *    submitted. Shared IPs never collide on it, while a script
	 *    hammering one identity is stopped almost immediately.
	 *  - REGISTRATION_IP_LIMITER keys on the client IP with a ceiling
	 *    sized for a burst of real students — its only job is to stop
	 *    floods of fabricated registration numbers, which a per-identity
	 *    key cannot see.
	 *  - AUTH_LIMITER guards the OAuth endpoints, which write a state
	 *    row per hit and are only ever used by a handful of admins.
	 */
	"unsafe": {
		"bindings": [
			{
				"name": "REGISTRATION_ID_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1101",
				"simple": { "limit": 5, "period": 60 }
			},
			{
				"name": "REGISTRATION_IP_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1102",
				"simple": { "limit": 60, "period": 60 }
			},
			{
				"name": "AUTH_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1103",
				"simple": { "limit": 10, "period": 60 }
			}
		]
	},

	"r2_buckets": [
		{
			"bucket_name": "osc-events-archives",
			"binding": "osc_events_archives"
		}
	],

	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }

	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 *
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {
	//   "MY_VARIABLE": "production_value"
	// }

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {
	//   "directory": "./public/",
	//   "binding": "ASSETS"
	// }

	/**
	 * Service Bindings
	 * https://developers.cloudflare.com/workers/configuration/#service-bindings
	 */
	// "services": [
	//   {
	//     "binding": "MY_SERVICE",
	//     "service": "my-service"
	//   }
	// ]
}