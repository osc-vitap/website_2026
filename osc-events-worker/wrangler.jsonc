/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",

	"name": "osc-events-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-20",

	"observability": {
		"enabled": true
	},

	"upload_source_maps": true,

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "osc-events-db",
			"database_id": "dd7fdbce-852d-41b3-a2cf-6106cdb69fc6"
		}
	],

	/**
	 * Comma-separated list of browser origins allowed to call this
	 * Worker. http://localhost:5173 and http://127.0.0.1:5173 are
	 * always allowed in addition to these.
	 */
	"vars": {
		"ALLOWED_ORIGINS": "https://www.oscvitap.com,https://oscvitap.com",

		/**
		 * Comma-separated GitHub handles allowed into the admin
		 * dashboard, on top of the osc-vitap organisation membership
		 * check. Leave empty to allow anyone in the organisation.
		 */
		"ADMIN_GITHUB_USERS": ""
	},

	"secrets": {
		"required": [
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
                       "DISCORD_WEBHOOK_URL"
		]
	},

	"r2_buckets": [
		{
			"bucket_name": "osc-events-archives",
			"binding": "osc_events_archives"
		}
	],

	"triggers": {
		"crons": [
			"0 * * * *"
		]
	}

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" }

	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 *
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {
	//   "MY_VARIABLE": "production_value"
	// }

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {
	//   "directory": "./public/",
	//   "binding": "ASSETS"
	// }

	/**
	 * Service Bindings
	 * https://developers.cloudflare.com/workers/configuration/#service-bindings
	 */
	// "services": [
	//   {
	//     "binding": "MY_SERVICE",
	//     "service": "my-service"
	//   }
	// ]
}
